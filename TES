            NameTxt.TextSize = 10
            NameTxt.TextXAlignment = Enum.TextXAlignment.Left
            NameTxt.Parent = Padding
            
            local TypeTxt = Instance.new("TextLabel")
            TypeTxt.Size = UDim2.new(0.8, 0, 0.1, 0)
            TypeTxt.Position = UDim2.new(0, 0, 0.9, 0)
            TypeTxt.BackgroundTransparency = 1
            TypeTxt.Font = Enum.Font.GothamMedium
            TypeTxt.Text = mod.Type
            TypeTxt.TextColor3 = Color3.fromRGB(120, 120, 120)
            TypeTxt.TextSize = 9
            TypeTxt.TextXAlignment = Enum.TextXAlignment.Left
            TypeTxt.Parent = Padding
            
