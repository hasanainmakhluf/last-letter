            Padding.Position = UDim2.new(0.5, 0, 0.5, 0)
            Padding.AnchorPoint = Vector2.new(0.5, 0.5)
            Padding.BackgroundTransparency = 1
            Padding.Parent = Card
            
            local Img = Instance.new("ImageLabel")
            Img.Size = UDim2.new(1, 0, 0.7, 0)
            Img.Image = mod.Image ~= "" and mod.Image or "rbxassetid://10734898355"
            Img.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            Img.ScaleType = Enum.ScaleType.Crop
            Img.Parent = Padding
            Instance.new("UICorner", Img).CornerRadius = UDim.new(0, 4)
            
            local NameTxt = Instance.new("TextLabel")
            NameTxt.Size = UDim2.new(0.8, 0, 0.15, 0)
            NameTxt.Position = UDim2.new(0, 0, 0.75, 0)
            NameTxt.BackgroundTransparency = 1
            NameTxt.Font = Enum.Font.GothamBold
            NameTxt.Text = mod.Name
