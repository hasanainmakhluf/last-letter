            PlayBtn.MouseButton1Click:Connect(function()
                if mod.ScriptLink and mod.ScriptLink ~= "" then
                    PureStandardExecute(mod.ScriptLink)
                end
            end)
        end
    else
        CategoryLabel.Text = "Map: " .. mapName .. " (No Scripts Found)"
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
end

