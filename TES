local function LoadMods()
    local currentId = game.PlaceId
    local mapName = "Unknown Map"
    pcall(function() mapName = MarketPlaceService:GetProductInfo(currentId).Name end)
    CategoryLabel.Text = "Map: " .. mapName
    
    local mods = ModDatabase[currentId]
    if mods then
        local rowCount = math.ceil(#mods / 3)
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, rowCount * 190)

        for i = 1, #mods do
            local mod = mods[i]
            local Card = Instance.new("Frame")
            Card.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            Card.BorderSizePixel = 0
